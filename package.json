{
  "name": "@crowdstrike/falcon-guardian-opencode-collector",
  "version": "0.0.0-semantic-release",
  "description": "Falcon Guardian collector for OpenCode",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CrowdStrike/falcon-guardian-opencode-collector.git"
  },
  "type": "module",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "LICENSE.txt",
    "README.md"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "node --test 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@crowdstrike/aidr": "1.3.0",
    "@opencode/plugin": "2.0.26",
    "@opencode/schema": "2.0.26",
    "effect": "4.0.0-rc.112",
    "plist": "5.0.0",
    "safe-execa": "0.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.6",
    "@tsconfig/node22": "22.0.5",
    "@types/node": "22.19.17",
    "typescript": "5.9.3"
  }
}
